# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*client_secret*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent and local tooling files
.*
!/.gitignore
!/.eslintrc.json
!/.vscode/
# .env.example must be committable — the `.*` rule above would otherwise hide it,
# which is why the project had no discoverable list of required variables.
!/.env.example
.dev.err
.dev.log
skills-lock.json
/skills/

# MoneyPrinterTurbo upstream clone (see docs/MONEYPRINTER_SETUP.md)
tools/
