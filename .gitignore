# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
# Build-cache directories moved aside during local rebuilds (the sandbox's
# delete guard refuses to let `next build` clear .next, so it gets renamed).
/.next.bak-*/
/.next.stale-*/
/.next.discard-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*client_secret*.json

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent and local tooling files
.*
!/.gitignore
!/.eslintrc.json
# Must be tracked: it keeps the ~2 GB bundled tool + venv out of deployments.
# The `.*` rule above would otherwise ignore it, so it would never reach CI.
!/.vercelignore
!/.vscode/
# .env.example must be committable — the `.*` rule above would otherwise hide it,
# which is why the project had no discoverable list of required variables.
!/.env.example
.dev.err
.dev.log
skills-lock.json
/skills/

# MoneyPrinterTurbo upstream clone (see docs/MONEYPRINTER_SETUP.md)
tools/
_tools_stash/
scratch/
