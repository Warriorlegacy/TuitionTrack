# TuitionTrack / EduPulse AI — environment template.
# Copy to `.env.local` and fill in. Never commit real keys.
#   cp .env.example .env.local

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy JWT keys — still accepted by PostgREST.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy anon JWT>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Server-only privileged key. BYPASSES Row Level Security — never prefix it with
# NEXT_PUBLIC_, and never reference it from next.config `env`.
SUPABASE_SECRET_KEY=sb_secret_<...>
# Legacy alias, read only as a fallback. Prefer SUPABASE_SECRET_KEY above —
# a stale value here previously shadowed .env.local and made every privileged
# call 401 with "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=
# Only used by scripts/apply-migrations.mjs and scripts/db-status.mjs.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── AI provider (blueprint #65 model tiers) ───────────────────────────────
# OpenAI (`sk-…`) or OpenRouter (`sk-or-…`, auto-detected). OpenRouter lets each
# tier point at a different vendor with no code change.
OPENAI_API_KEY=
# Optional override for any OpenAI-compatible endpoint.
# e.g. AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
# Per-tier model slugs. On OpenRouter use vendor-namespaced names.
AI_MODEL_TIER_A=openai/gpt-4o-mini
AI_MODEL_TIER_B=openai/gpt-4o-mini
AI_MODEL_TIER_C=openai/gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Cost guard: "1" disables every AI call immediately.
AI_KILL_SWITCH=0
AI_PER_STUDENT_CAP_USD=5

# ── Extra providers (all optional; platform chain is free-first) ─────────────
# Free-first order: Groq → Gemini → OpenRouter → NVIDIA → HuggingFace →
# OpenAI → DeepSeek → GitHub Models → Ollama local.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=
# Cheap ($0.14/$0.28 per 1M tokens); shares the sk- prefix with OpenAI, so
# pick provider "deepseek" explicitly in Settings → AI.
DEEPSEEK_API_KEY=
# GitHub Models free tier (NOT GITHUB_TOKEN — that name collides with Actions).
GITHUB_MODELS_TOKEN=
# Local Ollama (no key, no secrets — free). Set the base URL to enable it.
OLLAMA_BASE_URL=

# ── AI video generation (all free-tier, all optional) ─────────────────────
# HuggingFace `hf_…` token (free) powers text-to-video (LTX-Video, HunyuanVideo).
# Reuse your existing HUGGINGFACE_API_KEY — no new key needed.
# Override the default video model ordered list head:
AI_VIDEO_MODEL=
# Pollinations video needs no key (keyless free tier); a key from
# enter.pollinations.ai raises rate limits when you have one.
POLLINATIONS_API_KEY=
# Optional Pollinations model override (default: seedance).
AI_VIDEO_POLLINATIONS_MODEL=

# ── BYOK encryption (Bring Your Own Key) ────────────────────────────────────
# 32-byte base64 key for AES-GCM encryption of user API keys at rest.
# Generate: openssl rand -base64 32
AI_KEY_ENC_KEY=

# ── Comms ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Jobs ──────────────────────────────────────────────────────────────────
# Required. /api/cron/* fails closed (500) when this is unset, because the
# x-vercel-cron header alone is spoofable.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
