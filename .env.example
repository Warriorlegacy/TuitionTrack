# TuitionTrack / EduPulse AI — environment template.
# Copy to `.env.local` and fill in. Never commit real keys.
#   cp .env.example .env.local

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy JWT keys — still accepted by PostgREST.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy anon JWT>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Server-only privileged key. BYPASSES Row Level Security — never prefix it with
# NEXT_PUBLIC_, and never reference it from next.config `env`.
SUPABASE_SECRET_KEY=sb_secret_<...>
# Legacy alias, read only as a fallback. Prefer SUPABASE_SECRET_KEY above —
# a stale value here previously shadowed .env.local and made every privileged
# call 401 with "Invalid API key".
SUPABASE_SERVICE_ROLE_KEY=
# Only used by scripts/apply-migrations.mjs and scripts/db-status.mjs.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── AI provider (blueprint #65 model tiers) ───────────────────────────────
# OpenAI (`sk-…`) or OpenRouter (`sk-or-…`, auto-detected). OpenRouter lets each
# tier point at a different vendor with no code change.
OPENAI_API_KEY=
# Optional override for any OpenAI-compatible endpoint.
# e.g. AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
# Per-tier model slugs. On OpenRouter use vendor-namespaced names.
AI_MODEL_TIER_A=openai/gpt-4o-mini
AI_MODEL_TIER_B=openai/gpt-4o-mini
AI_MODEL_TIER_C=openai/gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Cost guard: "1" disables every AI call immediately.
AI_KILL_SWITCH=0
AI_PER_STUDENT_CAP_USD=5

# ── BYOK encryption (Bring Your Own Key) ────────────────────────────────────
# 32-byte base64 key for AES-GCM encryption of user API keys at rest.
# Generate: openssl rand -base64 32
AI_KEY_ENC_KEY=

# ── Comms ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Jobs ──────────────────────────────────────────────────────────────────
# Required. /api/cron/* fails closed (500) when this is unset, because the
# x-vercel-cron header alone is spoofable.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
